# ── Google AI Studio (Gemini) ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.0-flash was shut down on 1 June 2026; older IDs are auto-migrated.
GEMINI_MODEL=gemini-3.8-flash

# ── Groq (Examiner LLM, optional) ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# llama3-8b-8192 was decommissioned on 30 Aug 2025.
GROQ_MODEL=openai/gpt-oss-20b

# ── OpenRouter (optional fallback) ────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Google Sheets / Docs export (optional) ────────────────────────────────────
# Set GOOGLE_EXPORT_ENABLED=true and provide path to your service account JSON
GOOGLE_EXPORT_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service_account.json
